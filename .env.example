# Facilito environment — NEVER put real secrets in git.
# Copy to .env and fill locally. All values below are placeholders.

# --- Core ---
NODE_ENV=development
API_PORT=3001
# Keep on loopback when the API sits behind the Next.js proxy; only expose it behind a trusted proxy.
API_HOST=127.0.0.1
# Web (Next.js) proxies /api/* to this URL, so the browser only talks to one origin.
API_INTERNAL_URL=http://127.0.0.1:3001
WEB_PUBLIC_URL=http://localhost:3000

# --- Database ---
# pglite = embedded Postgres (local dev without Docker; RLS enforced via SET ROLE facilito_app)
# pg     = real PostgreSQL (CI / staging / production)
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=./.data/pglite
# Run migrations automatically on API start (pglite only).
AUTO_MIGRATE=true

# Real PostgreSQL (DATABASE_DRIVER=pg). The app role MUST be NOBYPASSRLS.
DATABASE_URL=postgres://facilito_app:CHANGE_ME_APP@localhost:5432/facilito
# Used only by migrations / bootstrap — never by the running API process.
DATABASE_ADMIN_URL=postgres://facilito_migrator:CHANGE_ME_MIGRATOR@localhost:5432/facilito
# Password assigned to facilito_app by `pnpm --filter @facilito/api db:bootstrap` (>= 12 chars).
APP_DB_PASSWORD=CHANGE_ME_APP

# --- Redis (optional; falls back to in-memory cache and counters) ---
REDIS_URL=

# --- Auth (JWT RS256) ---
# Required in production. Generate:
#   openssl genrsa -out secrets/jwt-private.pem 2048
#   openssl rsa -in secrets/jwt-private.pem -pubout -out secrets/jwt-public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Refresh cookie (httpOnly, SameSite=Strict). COOKIE_SECURE must be true in production (HTTPS).
COOKIE_SECURE=false
COOKIE_PATH=/api/v1/auth

# --- Field encryption (RNC, cédula, TOTP) — 32-byte base64 ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# --- HTTP hardening ---
# Comma-separated allowlist of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
# Reverse-proxy hops whose X-Forwarded-For the API trusts (controls req.ip for rate limits).
# Keep 0 when only the Next.js rewrite sits in front: Next forwards a client-supplied X-Forwarded-For
# unchanged, so trusting it lets clients pick their own IP. In production, route /api through an edge
# proxy that OVERWRITES X-Forwarded-For (Caddy/nginx `$remote_addr`, Vercel, Cloudflare) and set 1.
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Session refresh (every page load, every device behind the same IP)
AUTH_REFRESH_RATE_LIMIT_MAX=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# --- Uploads (product images) ---
UPLOAD_DIR=./.data/uploads
UPLOAD_MAX_BYTES=2097152

# --- Copilot / LLM (ports — stub in local/CI) ---
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
COPILOT_SERVICE_URL=http://localhost:3002

# --- e-CF / PSFE (ports — stub in local/CI) ---
# TODO: VERIFICAR EN VIVO — PSFE endpoints, DGII contingency windows, certificate rules
ECF_SERVICE_URL=http://localhost:3003
PSFE_PROVIDER=stub
PSFE_BASE_URL=
PSFE_API_KEY=

# --- Instagram (Meta Graph API) — not implemented; see docs/instagram-integration.md ---
# Stays off until a Meta app is approved and the business connects its Instagram Business account via OAuth.
# TODO: VERIFICAR EN VIVO — scopes and Graph API version on developers.facebook.com.
FEATURE_INSTAGRAM_OAUTH_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=

# --- File scan ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Feature flags ---
FEATURE_ECF_ENABLED=false
FEATURE_COPILOT_ENABLED=true
