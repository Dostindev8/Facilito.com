{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@facilito/api...",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{migrations/**,assets/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
